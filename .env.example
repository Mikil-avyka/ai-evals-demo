# Copy this file to `.env` and fill in your key.
# promptfoo automatically loads `.env` from the directory you run it in,
# and the Python agent loads it too (via python-dotenv).

# Used by BOTH the agent under test and the promptfoo model-graded assertions (the "grader").
ANTHROPIC_API_KEY=

# Optional: set to 0 to disable the agent's on-disk response cache (forces fresh API calls).
# Keep it at 1 for the live demo so re-runs are instant and deterministic.
HELPDESK_CACHE=1

# Optional: keep red-team attack generation fully local (uses Claude via redteam.provider)
# instead of promptfoo's hosted generation service. Recommended for company data.
PROMPTFOO_DISABLE_REMOTE_GENERATION=true

# Optional: skip promptfoo's anonymous usage telemetry.
PROMPTFOO_DISABLE_TELEMETRY=1

# Optional (Windows): point promptfoo at a specific Python interpreter if `python` is not on PATH.
# PROMPTFOO_PYTHON=C:\Python314\python.exe
